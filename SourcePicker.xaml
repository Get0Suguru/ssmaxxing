<Window x:Class="ScreenSnipAlpha.SourcePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSnip — share"
        Width="420" Height="160"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" FontSize="13"
                   Text="Same picker Windows / Meet uses: screens and windows on this desktop."/>
        <TextBlock Margin="0,8,0,0" FontSize="12" Opacity="0.7"
                   Text="A yellow border stays on the shared window. CapsLock+V pastes the latest frame."/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Name="ShareButton" Content="Share window or screen…" Padding="12,6"
                    Click="ShareButton_Click" IsDefault="True"/>
            <Button Content="Entire screen (no border)" Padding="12,6" Margin="8,0,0,0"
                    Click="EntireScreen_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
