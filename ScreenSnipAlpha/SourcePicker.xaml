<Window x:Class="ScreenSnipAlpha.SourcePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSnip — pick source"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#FF1E1E1E"
        KeyDown="Window_KeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10"
                   Text="Current desktop — click a card (no extra confirm)"
                   Foreground="#FFCCCCCC" FontSize="13"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel Name="CardPanel" ItemWidth="160" ItemHeight="130"/>
        </ScrollViewer>
    </DockPanel>
</Window>
