<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 TFM is what pulls in the WinRT projections for
         Windows.Graphics.Capture / Direct3D11 automatically, no extra NuGet needed -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RootNamespace>ScreenSnipAlpha</RootNamespace>
    <AssemblyName>ScreenSnipAlpha</AssemblyName>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- App identity / file properties (shows up in Explorer's Details tab, the
         installer, and Task Manager instead of the generic dotnet defaults). -->
    <Product>ScreenSnipAlpha</Product>
    <AssemblyTitle>ScreenSnipAlpha</AssemblyTitle>
    <Company>ScreenSnipAlpha</Company>
    <Description>Snip a window and paste it in one keystroke.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Only applied when publishing with an explicit win-x64 runtime identifier and
       self contained set (see BUILD_INSTALLER.md) — deliberately NOT in the main
       PropertyGroup above so that everyday dotnet build / dotnet run during dev
       work stay a fast, lightweight framework-dependent build instead of always
       resolving/copying a full self-contained win-x64 runtime. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is unreliable with WPF/WinForms + WinRT reflection — leave off. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF + UseWindowsForms both auto-inject a global 'using' for their namespace,
         and those collide on shared type names (Application, KeyEventArgs, etc).
         Drop the Forms one; the few Forms types we need are referenced via an alias. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.1" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.1" />
  </ItemGroup>

</Project>
