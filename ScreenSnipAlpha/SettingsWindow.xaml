<Window x:Class="ScreenSnipAlpha.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSnip — Settings"
        Width="440" Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1E1E1E">
    <StackPanel Margin="20">
        <TextBlock Text="Hotkeys" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Modifier" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
            <ComboBox Name="ModBox" Grid.Column="1">
                <ComboBoxItem Content="Alt" Tag="18"/>
                <ComboBoxItem Content="Ctrl" Tag="17"/>
                <ComboBoxItem Content="Shift" Tag="16"/>
                <ComboBoxItem Content="Win" Tag="91"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Capture key" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
            <TextBox Name="CaptureKeyBox" Grid.Column="1" MaxLength="1" CharacterCasing="Upper"/>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Source-picker key" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
            <TextBox Name="SourceKeyBox" Grid.Column="1" MaxLength="1" CharacterCasing="Upper"/>
        </Grid>

        <TextBlock Text="Clipboard" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <CheckBox Name="KeepClipCheck" Foreground="White" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="White"
                       Text="Also leave screenshot on clipboard (uncheck = paste only, restore previous clipboard)"/>
        </CheckBox>
        <TextBlock Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Hotkey always pastes into the focused field. This only controls whether the image stays on the clipboard afterward."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="90" Padding="8,4" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Padding="8,4" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
